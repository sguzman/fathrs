{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fathrs links.toml",
  "description": "Declarative source-to-destination mappings for Fathrs.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "$ref": "#/$defs/section"
  },
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "copy": {
          "type": "boolean"
        },
        "doas": {
          "type": "boolean"
        },
        "sudo": {
          "type": "boolean",
          "deprecated": true,
          "description": "Backward-compatible alias for doas."
        }
      },
      "not": {
        "required": [
          "doas",
          "sudo"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/link"
      }
    },
    "link": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "copy": {
              "type": "boolean"
            },
            "doas": {
              "type": "boolean"
            },
            "sudo": {
              "type": "boolean",
              "deprecated": true,
              "description": "Backward-compatible alias for doas."
            }
          },
          "required": [
            "target"
          ],
          "not": {
            "required": [
              "doas",
              "sudo"
            ]
          }
        }
      ]
    }
  }
}
